# LifeLink Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual production keys or secrets to version control.

# =======================================================
# SUPABASE CONFIGURATION (Phase 2)
# =======================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# =======================================================
# MAPS & GEOLOCATION (Phase 4 / 5)
# =======================================================
# OpenStreetMap tile server or configured map provider
VITE_MAP_TILE_LAYER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_DEFAULT_CITY=Bengaluru
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946

# =======================================================
# PUSH NOTIFICATIONS & MULTICHANNEL (Phase 7)
# =======================================================
VITE_FIREBASE_VAPID_KEY=your-firebase-public-vapid-key
VITE_SMS_GATEWAY_API_KEY=your-sms-gateway-api-key
VITE_SMS_DLT_SENDER_ID=LIFELK
VITE_EMAIL_SERVICE_API_KEY=re_your_resend_or_sendgrid_key

# =======================================================
# APPLICATION METADATA
# =======================================================
VITE_APP_NAME="LifeLink"
VITE_APP_TAGLINE="Every Drop Counts. Be Someone's Lifeline."
VITE_APP_URL=http://localhost:5173
